rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Anti-spam: lifetime posts (listings + requests) per account.
    // stats/{uid}.postCount is maintained by the client in the same batch
    // as each create; only +1 steps by the owner are allowed.
    function postCountOk() {
      return !exists(/databases/$(database)/documents/stats/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/stats/$(request.auth.uid))
          .data.get('postCount', 0) < 100;
    }

    function requesterDisabled() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == true;
    }

    function canWrite() {
      return signedIn() && !requesterDisabled();
    }

    function validListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
        data.description is string && data.description.size() <= 800 &&
        data.category is string && data.category.size() > 0 &&
        data.wilaya is string && data.wilaya.size() > 0 &&
        data.commune is string && data.commune.size() > 0 &&
        data.condition is string && data.condition.size() > 0 &&
        data.contactPhone is string && data.contactPhone.size() >= 9 && data.contactPhone.size() <= 20 &&
        data.ownerName is string && data.ownerName.size() <= 100 &&
        data.status is string &&
        data.get('kind', 'تبرع') in ['تبرع', 'تبادل'] &&
        data.imageCount is int && data.imageCount >= 0 && data.imageCount <= 5 &&
        data.keywords is list && data.keywords.size() <= 3000 &&
        (data.image0 == null || (data.image0 is string && data.image0.size() < 150000));
    }

    // Owners may only move a listing between the two canonical statuses;
    // admins bypass every content check (moderation edits).
    function ownerListing(data) {
      return validListing(data) &&
        data.status in ['متاح', 'تم التبرع به'];
    }

    function unchangedFrozen(data) {
      return data.ownerId == resource.data.ownerId &&
        data.createdAt == resource.data.createdAt;
    }

    function claimKeysUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['claimedBy', 'claimedByName', 'claimedAt']);
    }

    // Board posts (requests): type need|offer, status open|matched|closed.
    // kind general|blood (absent = general, pre-blood clients); blood posts
    // are always type need and carry a valid bloodType.
    function kBloodTypes() {
      return ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
    }

    function validRequest(data) {
      return data.uid is string && data.uid.size() > 0 &&
        data.userName is string && data.userName.size() <= 100 &&
        data.type in ['need', 'offer'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 800 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        data.wilaya is string && data.wilaya.size() > 0 &&
        data.commune is string && data.commune.size() > 0 &&
        data.contactPhone is string && data.contactPhone.size() >= 9 && data.contactPhone.size() <= 20 &&
        data.keywords is list && data.keywords.size() <= 3000 &&
        data.status in ['open', 'matched', 'closed'] &&
        data.get('kind', 'general') in ['general', 'blood'] &&
        (data.get('bloodType', null) == null ||
          data.get('bloodType', null) in kBloodTypes()) &&
        (data.get('kind', 'general') != 'blood' ||
          (data.type == 'need' &&
            data.get('bloodType', null) in kBloodTypes()));
    }

    function requestMatchKeysUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['matchedBy', 'matchedName', 'matchedAt']);
    }

    // Content edits may never convert a post between general and blood;
    // bloodType may only stay as-is or change to another valid type.
    function requestKindEditAllowed() {
      return request.resource.data.get('kind', 'general') ==
          resource.data.get('kind', 'general') &&
        (request.resource.data.get('bloodType', null) ==
            resource.data.get('bloodType', null) ||
          (request.resource.data.get('bloodType', null) is string &&
            request.resource.data.get('bloodType', null) in kBloodTypes()));
    }

    // User profiles: PII — readable only by the owner and admins.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(
          ['fullName', 'email', 'wilaya', 'commune', 'contactPhone', 'disabled', 'createdAt']) &&
        request.resource.data.disabled == false &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.wilaya is string && request.resource.data.wilaya.size() <= 60 &&
        request.resource.data.commune is string && request.resource.data.commune.size() <= 60 &&
        (request.resource.data.contactPhone == null ||
          (request.resource.data.contactPhone is string &&
            request.resource.data.contactPhone.size() <= 20));
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'wilaya', 'commune', 'contactPhone']) &&
          request.resource.data.fullName is string &&
          request.resource.data.fullName.size() > 0 &&
          request.resource.data.fullName.size() <= 100 &&
          request.resource.data.disabled == resource.data.disabled);
      allow delete: if isAdmin();
    }

    // Admin membership. Initial admins are seeded from the Firebase console /
    // Admin SDK; existing admins can grant or revoke via the in-app panel.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Lifetime post counter (anti-spam). Clients bump postCount by exactly
    // +1 in the same batch as each listing/request create.
    match /stats/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['postCount']) &&
        request.resource.data.postCount is int &&
        request.resource.data.postCount == 1;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['postCount']) &&
        request.resource.data.postCount is int &&
        request.resource.data.postCount == resource.data.postCount + 1;
      allow delete: if isAdmin();
    }

    // Listings — status lifecycle:
    //   متاح  --claim-->  محجوز  --owner confirms-->  تم التبرع به
    //   (owner may also go متاح <-> تم التبرع به directly, as before;
    //    cancel returns محجوز -> متاح and clears the claim fields)
    match /listings/{id} {
      allow read: if signedIn();
      allow create: if canWrite() &&
        request.resource.data.ownerId == request.auth.uid &&
        validListing(request.resource.data) &&
        postCountOk() &&
        request.resource.data.status == 'متاح' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !request.resource.data.keys()
          .hasAny(['claimedBy', 'claimedByName', 'claimedAt']);

      allow update: if isAdmin() ||
        // (A) Owner content / canonical status edits. Claim fields are
        //     never touched here, and a reservation may only leave the
        //     reservation paths below — never by flipping status alone.
        (canWrite() &&
          resource.data.ownerId == request.auth.uid &&
          unchangedFrozen(request.resource.data) &&
          validListing(request.resource.data) &&
          (ownerListing(request.resource.data) ||
            request.resource.data.status == resource.data.status) &&
          claimKeysUntouched() &&
          (resource.data.status != 'محجوز' ||
            request.resource.data.status == 'محجوز')) ||
        // (B) Claim: any signed-in non-owner reserves an available listing.
        (canWrite() &&
          resource.data.status == 'متاح' &&
          request.resource.data.status == 'محجوز' &&
          request.resource.data.claimedBy == request.auth.uid &&
          request.resource.data.claimedBy != resource.data.ownerId &&
          request.resource.data.claimedByName is string &&
          request.resource.data.claimedByName.size() <= 100 &&
          request.resource.data.claimedAt == request.time &&
          unchangedFrozen(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'claimedBy', 'claimedByName', 'claimedAt', 'updatedAt'])) ||
        // (C) Cancel: owner or claimant releases the reservation.
        (canWrite() &&
          resource.data.status == 'محجوز' &&
          request.resource.data.status == 'متاح' &&
          request.resource.data.claimedBy == null &&
          request.resource.data.claimedByName == null &&
          request.resource.data.claimedAt == null &&
          unchangedFrozen(request.resource.data) &&
          (request.auth.uid == resource.data.ownerId ||
            request.auth.uid == resource.data.claimedBy) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'claimedBy', 'claimedByName', 'claimedAt', 'updatedAt'])) ||
        // (D) Confirm delivery: owner only; claim fields stay for trust.
        (canWrite() &&
          resource.data.status == 'محجوز' &&
          request.resource.data.status == 'تم التبرع به' &&
          request.auth.uid == resource.data.ownerId &&
          unchangedFrozen(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin() ||
        (canWrite() && resource.data.ownerId == request.auth.uid);

      // Listing images (base64 payloads). The document id is the image
      // index ('0'..'4'), which caps each listing at 5 image documents.
      match /images/{imgId} {
        allow read: if signedIn();
        allow create, update: if canWrite() &&
          get(/databases/$(database)/documents/listings/$(id)).data.ownerId == request.auth.uid &&
          request.resource.data.index is int &&
          request.resource.data.index >= 0 &&
          request.resource.data.index < 5 &&
          string(request.resource.data.index) == imgId &&
          request.resource.data.data is string &&
          request.resource.data.data.size() < 900000;
        allow delete: if isAdmin() ||
          (canWrite() &&
            get(/databases/$(database)/documents/listings/$(id)).data.ownerId == request.auth.uid);
      }
    }

    // Reports: created by users, managed by admins. Reason is a fixed enum
    // (kReportReasons in lib/utils/constants.dart).
    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if canWrite() &&
        request.resource.data.keys().hasOnly(
          ['listingId', 'listingTitle', 'reporterId', 'reporterName', 'reason', 'description', 'createdAt']) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.listingId is string &&
        request.resource.data.listingId.size() > 0 &&
        request.resource.data.listingId.size() <= 64 &&
        request.resource.data.listingTitle is string &&
        request.resource.data.listingTitle.size() <= 80 &&
        request.resource.data.reporterName is string &&
        request.resource.data.reporterName.size() <= 100 &&
        request.resource.data.reason in [
          'محتوى غير مناسب',
          'معلومات كاذبة',
          'الغرض تم الحصول عليه مسبقاً',
          'إعلان مكرر',
          'أخرى'] &&
        (request.resource.data.description == null ||
          (request.resource.data.description is string &&
            request.resource.data.description.size() <= 1000)) &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Board posts — status lifecycle:
    //   open --another user matches--> matched
    //   matched --matcher/owner--> open (release)  |  --owner--> closed
    //   open <-> closed (owner toggle)
    match /requests/{id} {
      allow read: if signedIn();
      allow create: if canWrite() &&
        request.resource.data.uid == request.auth.uid &&
        validRequest(request.resource.data) &&
        postCountOk() &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        !request.resource.data.keys()
          .hasAny(['matchedBy', 'matchedName', 'matchedAt']);

      allow update: if isAdmin() ||
        // (A) Owner content edit — status, match keys and kind untouched.
        (canWrite() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.status == resource.data.status &&
          validRequest(request.resource.data) &&
          requestKindEditAllowed() &&
          requestMatchKeysUntouched()) ||
        // (B) Owner toggles open <-> closed.
        (canWrite() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          resource.data.status in ['open', 'closed'] &&
          request.resource.data.status in ['open', 'closed'] &&
          request.resource.data.status != resource.data.status &&
          validRequest(request.resource.data) &&
          requestMatchKeysUntouched() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])) ||
        // (C) Match: any signed-in non-author answers an open post.
        (canWrite() &&
          resource.data.status == 'open' &&
          request.resource.data.status == 'matched' &&
          request.resource.data.matchedBy == request.auth.uid &&
          request.resource.data.matchedBy != resource.data.uid &&
          request.resource.data.matchedName is string &&
          request.resource.data.matchedName.size() <= 100 &&
          request.resource.data.matchedAt == request.time &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'matchedBy', 'matchedName', 'matchedAt', 'updatedAt'])) ||
        // (D) Leave matched: matcher or author releases back to open;
        //     only the author may finalize to closed.
        (canWrite() &&
          resource.data.status == 'matched' &&
          request.resource.data.matchedBy == null &&
          request.resource.data.matchedName == null &&
          request.resource.data.matchedAt == null &&
          ((request.resource.data.status == 'open' &&
              (request.auth.uid == resource.data.uid ||
                request.auth.uid == resource.data.matchedBy)) ||
            (request.resource.data.status == 'closed' &&
              request.auth.uid == resource.data.uid)) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'matchedBy', 'matchedName', 'matchedAt', 'updatedAt']));

      allow delete: if isAdmin() ||
        (canWrite() && resource.data.uid == request.auth.uid);
    }
  }
}
